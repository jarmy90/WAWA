# =====================================================================
# Autonomous Business Lab — variables de entorno
# Copia este archivo a `.env` y ajusta los valores. Ninguna clave es
# obligatoria: el sistema funciona 100% offline sin API configurada.
# =====================================================================

# --- Modo de operación -----------------------------------------------
# auto   -> usa Gemini si está configurado y disponible; si no, usa el proveedor simulado.
# mock   -> proveedor simulado determinista (sin API, gratis). Recomendado para empezar.
# gemini -> fuerza Gemini; si falla, el sistema hace fallback a mock y lo registra.
# manual -> asistido por humano/Freebuff: lee investigaciones desde data/manual_research/responses/.
LLM_PROVIDER=auto

# Modo gratuito: nunca se gasta dinero real; todos los costes se registran como 0.
FREE_MODE=true
# Modo simulación: los límites de presupuesto se calculan y registran, pero nunca bloquean la ejecución.
SIMULATION_MODE=true

# --- Gemini (OPCIONAL, nunca obligatorio) ------------------------------
# Deja GEMINI_API_KEY vacío para usar solo el modo sin API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_REQUEST_TIMEOUT=60

# --- Control de costes (BudgetGuard) -----------------------------------
# Presupuesto diario total estimado en USD.
DAILY_BUDGET_USD=0.50
# Presupuesto máximo estimado por oportunidad.
PER_OPPORTUNITY_BUDGET_USD=0.20
# Máximo de evaluaciones profundas (pipeline completo) por día.
MAX_DEEP_EVALUATIONS_PER_DAY=5

# --- Puntuación (sobreescribe los valores por defecto en JSON) ---------
# SCORING_WEIGHTS_JSON={"pain":0.20,"demand":0.20,"customer_reach":0.15,"automation":0.15,"margin":0.10,"build_speed":0.10,"differentiation":0.05,"safety":0.05}
# DECISION_BANDS_JSON=[{"min_score":75,"decision":"approved"},{"min_score":60,"decision":"needs_more_research"},{"min_score":40,"decision":"deferred"},{"min_score":0,"decision":"rejected"}]

# --- Seguridad y límites ------------------------------------------------
MAX_UPLOAD_BYTES=1000000
# Extensiones permitidas en importaciones (lista blanca).
ALLOWED_IMPORT_EXTENSIONS=.json

# --- Logs ---------------------------------------------------------------
LOG_LEVEL=INFO
