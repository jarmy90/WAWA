# =====================================================================
# Autonomous Business Lab — variables de entorno
# Copia este archivo a `.env` y ajusta los valores. Ninguna clave es
# obligatoria: el sistema funciona 100% offline sin API configurada.
# =====================================================================

# --- Modo de operación -----------------------------------------------
# auto      -> usa OpenRouter o Gemini si están configurados y disponibles; si no, proveedor simulado.
# mock      -> proveedor simulado determinista (sin API, gratis). Recomendado para empezar.
# gemini    -> fuerza Gemini; si falla, el sistema hace fallback a mock y lo registra.
# openrouter -> fuerza OpenRouter; si falla, el sistema hace fallback a mock y lo registra.
# manual    -> asistido por humano/Freebuff: lee investigaciones desde data/manual_research/responses/.
LLM_PROVIDER=auto

# Modo gratuito: nunca se gasta dinero real; todos los costes se registran como 0.
FREE_MODE=true
# Modo simulación: los límites de presupuesto se calculan y registran, pero nunca bloquean la ejecución.
SIMULATION_MODE=true

# --- Gemini (OPCIONAL, nunca obligatorio) ------------------------------
# Deja GEMINI_API_KEY vacío para usar solo el modo sin API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_REQUEST_TIMEOUT=60

# --- OpenRouter (OPCIONAL, SOLO para el comité de contraste — Opción A) --
# Clave con formato sk-or-v1-... (gestor de claves del entorno / Settings -> Keys).
# El modelo del comité es FIJO para mantener comparabilidad entre revisiones.
OPENROUTER_API_KEY=
OPENROUTER_REVIEW_MODEL=openai/gpt-4o-mini
# Router gratuito como fallback: el modelo REAL usado por llamada puede variar
# y siempre se registra en llm_call_log (requested_model vs actual_model).
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_INPUT_TOKENS=6000
OPENROUTER_MAX_OUTPUT_TOKENS=2000
OPENROUTER_DAILY_REQUEST_LIMIT=30
OPENROUTER_DAILY_COST_LIMIT_USD=0.50
OPENROUTER_MONTHLY_COST_LIMIT_USD=5.00
OPENROUTER_MAX_REVIEWS_PER_OPPORTUNITY=1
OPENROUTER_CIRCUIT_BREAKER_FAILURES=5
OPENROUTER_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# --- OmniRoute (OPCIONAL, AISLADO — iteración 008) -----------------------
# Gateway local OpenAI-compatible que agrega proveedores/tiers gratuitos.
# Se ejecuta como SERVICIO SEPARADO (infra/omniroute/docker-compose.omniroute.yml,
# puerto 127.0.0.1:20128). DESACTIVADO por defecto; nunca sustituye a OpenRouter
# y NO se usa para Discovery general hasta superar el benchmark A/B.
OMNIROUTE_ENABLED=false
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# Clave del gateway local y token CLI (x-omniroute-cli-token): SOLO en el gestor
# de secretos / Settings -> Keys. Vacíos si el gateway local no exige auth.
OMNIROUTE_API_KEY=
OMNIROUTE_CLI_TOKEN=
OMNIROUTE_REVIEW_MODEL=auto
OMNIROUTE_DISCOVERY_MODEL=auto
OMNIROUTE_FALLBACK_MODEL=auto
OMNIROUTE_TIMEOUT_SECONDS=60
OMNIROUTE_MAX_RETRIES=1
OMNIROUTE_MAX_INPUT_TOKENS=
OMNIROUTE_MAX_OUTPUT_TOKENS=
OMNIROUTE_DAILY_REQUEST_LIMIT=20
OMNIROUTE_DAILY_COST_LIMIT_USD=0

# --- Ventana prioritaria OX Alpha (iteración 015) -------------------------
# Acceso gratuito TEMPORAL (hasta 2026-08-27 inclusive) al modelo que el
# propietario denomina "OX Alpha", a través del gateway OmniRoute.
# OX_ALPHA_SLUG debe dejarse VACÍO hasta verificar el slug EXACTO en el
# catálogo real del gateway (GET /v1/models). Vacío => OX_ALPHA_UNVERIFIED y
# el sistema NUNCA declara haber usado OX Alpha. Nunca inventar el slug.
OX_ALPHA_SLUG=
OX_ALPHA_EXPIRES_AT=2026-08-27
OX_ALPHA_DAILY_TASK_LIMIT=40
OX_ALPHA_MAX_INPUT_CHARS=24000
OMNIROUTE_MONTHLY_COST_LIMIT_USD=0
OMNIROUTE_ALLOW_FREE_ONLY=true
OMNIROUTE_REQUIRE_MODEL_ID=true

# --- Autonomous 24/7 Runtime (iteración 025) -----------------------------
# Modo de operación: FREEBUFF_SESSION_ONLY, AUTONOMOUS_24_7, SAFE_MAINTENANCE
WAWA_OPERATING_MODE=FREEBUFF_SESSION_ONLY

# Scheduler y worker: deben estar en el MISMO proceso Uvicorn.
# Si se usan múltiples workers, solo uno debe activar scheduler+worker.
AUTONOMOUS_RUNTIME_ENABLED=false
AUTONOMOUS_SCHEDULER_ENABLED=false
AUTONOMOUS_WORKER_ENABLED=false
AUTONOMOUS_POLL_INTERVAL_SECONDS=15
AUTONOMOUS_MAX_CONCURRENT_JOBS=2
AUTONOMOUS_JOB_LEASE_SECONDS=600

# OmniRoute como runtime principal (auto-route por tarea)
OMNIROUTE_MODEL_ALLOWLIST=
OMNIROUTE_DEFAULT_MODEL=auto

# LLM limits para modo autónomo
LLM_MAX_REQUESTS_PER_MINUTE=10
LLM_MAX_REQUESTS_PER_DAY=500
LLM_MAX_TOKENS_PER_JOB=12000
LLM_MAX_TOKENS_PER_DAY=150000
LLM_MAX_ESTIMATED_COST_USD_PER_DAY=0
LLM_HARD_BUDGET_ENFORCEMENT=true
LLM_MAX_RETRIES=2
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_SECONDS=900

# Permission gates (all false by default — safe defaults)
AUTONOMOUS_ALLOW_REAL_RESEARCH=true
AUTONOMOUS_ALLOW_EXTERNAL_READS=true
AUTONOMOUS_ALLOW_EXTERNAL_WRITES=false
AUTONOMOUS_ALLOW_OUTBOUND_CONTACT=false
AUTONOMOUS_ALLOW_PUBLICATION=false
AUTONOMOUS_ALLOW_FINANCIAL_ACTIONS=false
AUTONOMOUS_ALLOW_CODE_EXECUTION=false
AUTONOMOUS_ALLOW_PRODUCTION_DEPLOYMENT=false

# --- Control de costes (BudgetGuard) -----------------------------------
# Presupuesto diario total estimado en USD.
DAILY_BUDGET_USD=0.50
# Presupuesto máximo estimado por oportunidad.
PER_OPPORTUNITY_BUDGET_USD=0.20
# Máximo de evaluaciones profundas (pipeline completo) por día.
MAX_DEEP_EVALUATIONS_PER_DAY=5

# --- Puntuación (sobreescribe los valores por defecto en JSON) ---------
# SCORING_WEIGHTS_JSON={"pain":0.20,"demand":0.20,"customer_reach":0.15,"automation":0.15,"margin":0.10,"build_speed":0.10,"differentiation":0.05,"safety":0.05}
# DECISION_BANDS_JSON=[{"min_score":75,"decision":"approved"},{"min_score":60,"decision":"needs_more_research"},{"min_score":40,"decision":"deferred"},{"min_score":0,"decision":"rejected"}]

# --- Seguridad y límites ------------------------------------------------
MAX_UPLOAD_BYTES=1000000
# Extensiones permitidas en importaciones (lista blanca).
ALLOWED_IMPORT_EXTENSIONS=.json
# Revisiones externas: TXT simple, Markdown y JSON estructurado.
REVIEW_ALLOWED_EXTENSIONS=.txt,.md,.markdown,.json

# --- Logs ---------------------------------------------------------------
LOG_LEVEL=INFO
